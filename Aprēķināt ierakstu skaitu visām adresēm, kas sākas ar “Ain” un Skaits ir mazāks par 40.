from openpyxl import load_workbook
import re

wb = load_workbook('sagatave_eksamenam.xlsx')
ws = wb['Lapa_1']

count = 0

for row in range(2, ws.max_row + 1):
    address = ws['A' + str(row)].value
    if address and str(address).startswith("Ain"):
        match = re.search(r'\d+', str(address))
        if match and int(match.group()) < 40:
            count += 1

print(count)

from openpyxl import load_workbook
import math


wb = load_workbook('sagatave_eksamenam.xlsx')
ws = wb['Lapa_0']


total_sum = 0


for row in range(4, ws.max_row + 1):
    client_type = ws[f'F{row}'].value         
    quantity = ws[f'L{row}'].value               
    price = ws[f'K{row}'].value                  
    delivery_cost = ws[f'M{row}'].value          


    if (
        client_type == "Korporatīvais"
        and isinstance(quantity, int) and 40 <= quantity <= 50
        and isinstance(price, (int, float))
        and isinstance(delivery_cost, (int, float))
    ):
        total_sum += price * quantity + delivery_cost


rounded_total = math.floor(total_sum)


print(rounded_total)

from openpyxl import load_workbook
from datetime import datetime


wb = load_workbook('sagatave_eksamenam.xlsx')
ws = wb['Lapa_0']


count = 0

for row in range(4, ws.max_row + 1): 
    priority = ws[f'H{row}'].value
    delivery_date = ws[f'J{row}'].value

  
    if priority == "High" and isinstance(delivery_date, datetime) and delivery_date.year == 2015:
        count += 1


print(count)
